{
  "name": "retro-snake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A minimal retro-inspired Snake browser game.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "start:prod": "tsx server/index.ts --serve-dist",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && node --test tests/*.test.ts tests/security/*.test.ts",
    "test:e2e:security": "tsx scripts/e2e/secureArcade.e2e.ts",
    "test:security": "npm run typecheck && node --test tests/security/*.test.ts && npm run build && npm run test:e2e:security",
    "security:scan": "node scripts/security/pre-push-scan.mjs --worktree",
    "preview": "vite preview",
    "test:e2e": "tsx scripts/e2e/shopAdvisor.e2e.ts",
    "agent:live": "tsx scripts/live/agentSmoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  }
}
